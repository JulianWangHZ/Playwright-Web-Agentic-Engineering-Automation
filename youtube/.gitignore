# The root .gitignore already covers .env / dist/ / *.log; this only adds JS/Playwright-specific entries

node_modules/

# Playwright / BDD output
# tests/.features-gen = glue specs generated by bddgen (outputDir), regenerated from .feature + steps; not committed
# hand-written step definitions tests/ui/*.steps.ts are committed (ui test layer)
tests/.features-gen/
test-results/
smart-report.html
test-history.json

# login session (sensitive, do not commit)
.auth/

# planner evidence maps: contain real locators / test data, for local code-gen reference only
evidence/*
!evidence/README.md
