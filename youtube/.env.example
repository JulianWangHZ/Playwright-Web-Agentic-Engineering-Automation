# Target environment: dev | sit | prod (defaults to sit)
# URLs are auto-selected by config/test.config.ts based on ENV; you usually do not need to set BASE_URL manually
ENV=sit

# Only set these to override the auto-selected URLs
# BASE_URL=https://www.youtube.com
# API_BASE_URL=https://www.googleapis.com/youtube/v3

# Environment map (YouTube has no multi-env; dev/sit/prod all point to the production site):
# dev / sit / prod → web: https://www.youtube.com   api: https://www.googleapis.com/youtube/v3

# Browser settings
HEADLESS=true
# BROWSER=chromium        # chromium (default) | webkit | firefox
# DEVICE="iPhone 14"      # Playwright devices key; if unset, uses the engine desktop preset
# BROWSER_CHANNEL=chrome  # use system Chrome when the bundled chromium is broken (chromium only)

# On-failure behavior
VIDEO_ON_FAILURE=true
SCREENSHOT_ON_FAILURE=true
TRACE_ON_FAILURE=true

# Log
LOG_LEVEL=info
# LOG_FORMAT=json   # auto-enabled when CI=true

# CI overrides (usually no need to set manually)
# RETRY_COUNT=2
# PARALLEL_WORKERS=8
# TEST_TIMEOUT=30000
