# Jira credentials (local personal settings, not committed to git)
# Copy this file to `.claude/secrets.env` and fill in your details.
#
# Use case 1: atlassian MCP server (uvx mcp-atlassian) authentication — requires the
#             JIRA_URL / JIRA_USERNAME / JIRA_API_TOKEN name set; missing them starts
#             successfully but returns 0 tools.
# Use case 2: when the jira-sync skill uploads attachments (prototype.html), the MCP
#             does not support attachments, so Claude runs curl + Basic Auth to upload,
#             reusing the JIRA_USER / JIRA_BASE_URL aliases.
#
# Get an API Token:
#   Jira top-right avatar → Account settings → Security → API tokens → Create and manage API tokens
#
# ⚠️  secrets.env is already listed in .gitignore; do not manually git add this file.

# Names required by mcp-atlassian (sooperset) — missing this set returns 0 tools
JIRA_URL=https://your-workspace.atlassian.net
JIRA_USERNAME={your Atlassian account email}
JIRA_API_TOKEN={your Jira API Token}

# Aliases used by the skill's curl (same credentials)
JIRA_USER={your Atlassian account email}
JIRA_BASE_URL=https://your-workspace.atlassian.net
